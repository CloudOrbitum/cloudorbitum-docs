---
/**
 * <LatestChanges> — the newest changelog entries (src/content/changelog/),
 * for the home page. Usage (MDX): <LatestChanges count={3} />
 */
import { getCollection } from "astro:content";
import { withBase } from "@cloudflare/nimbus-docs/runtime";

interface Props {
  count?: number;
}
const { count = 3 } = Astro.props;
const entries = (await getCollection("changelog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, count);
const fmt = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", year: "numeric" });
const base = import.meta.env.BASE_URL;
---

<ul class="not-prose list-none p-0 m-0 flex flex-col border border-border rounded-[var(--r-lg)] bg-card divide-y divide-border">
  {entries.map((e) => (
    <li>
      <a href={withBase(`/changelog/#${e.id.split("/").pop()}`, base)} class="flex flex-col gap-1 px-5 py-4 no-underline hover:bg-accent transition-colors">
        <span class="text-[12px] text-muted-foreground">{fmt.format(e.data.date)} · {e.data.products.join(", ")}</span>
        <span class="text-[15px] font-semibold text-foreground">{e.data.title}</span>
        <span class="text-[14px] text-muted-foreground">{e.data.description}</span>
      </a>
    </li>
  ))}
</ul>
